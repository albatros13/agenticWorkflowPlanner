// Scenario 3 - Privacy technique not applied (GDPR Art. 5(1)(c))

#require "Init.eflint"

// Step 1 - Collect personal data
collect-personal-data("company-a", "data-subject", "building-energy-consumption-prediction", 1, "energy-consumption-data").
collect-personal-data("company-b", "data-subject", "building-energy-consumption-prediction", 1, "housing-characteristics-data").
collect-personal-data("company-c", "data-subject", "building-energy-consumption-prediction", 1, "climate-data").

// Verify personal-data-collection holds for all three companies
?Holds(personal-data-collection("company-a", 1, "data-subject", "building-energy-consumption-prediction", "energy-consumption-data")).
?Holds(personal-data-collection("company-b", 1, "data-subject", "building-energy-consumption-prediction", "housing-characteristics-data")).
?Holds(personal-data-collection("company-c", 1, "data-subject", "building-energy-consumption-prediction", "climate-data")).

?Holds(apply-privacy-techniques("company-a", "data-subject", 1, "building-energy-consumption-prediction", "energy-consumption-data")).
?Holds(apply-privacy-techniques("company-b", "data-subject", 1, "building-energy-consumption-prediction", "housing-characteristics-data")).
?Holds(apply-privacy-techniques("company-c", "data-subject", 1, "building-energy-consumption-prediction", "climate-data")).

// Step 2 - company-a and company-c fulfil privacy techniques duty
// company-b does not fulfil the duty
fulfil-privacy-techniques("company-a", "data-subject", 1, "building-energy-consumption-prediction", "energy-consumption-data").
fulfil-privacy-techniques("company-c", "data-subject", 1, "building-energy-consumption-prediction", "climate-data").

// Verify duty is violated for company-b
?Violated(apply-privacy-techniques("company-b", "data-subject", 1, "building-energy-consumption-prediction", "housing-characteristics-data")).

// Verify privacy-technique-applied holds for company-a and company-c
?Holds(privacy-technique-applied("company-a", 1, "building-energy-consumption-prediction","energy-consumption-data")).
?Holds(privacy-technique-applied("company-c", 1, "building-energy-consumption-prediction","climate-data")).

// Verify privacy-technique-applied does not hold for company-b
?Holds(privacy-technique-applied("company-b", 1, "building-energy-consumption-prediction","housing-characteristics-data")).

// Step 3 - Submit participation request
// company-a and company-c succeed
submit-participation-request("company-c", "company-a", 1, "building-energy-consumption-prediction", "climate-data", "data-subject").

// company-b can still submit but will be blocked at verification
submit-participation-request("company-b", "company-a", 1, "building-energy-consumption-prediction", "housing-characteristics-data", "data-subject").

// Verify participation-request-pending holds for company-c
?Holds(participation-request-pending("company-c", 1, "building-energy-consumption-prediction")).

// Verify participation-request-pending holds for company-b
?Holds(participation-request-pending("company-b", 1, "building-energy-consumption-prediction")).

// Step 4 - Verify compliance conditions
// company-c succeeds
verify-compliance-conditions("company-a", "company-c", 1, "building-energy-consumption-prediction", "climate-data").

// company-b fails at verify-compliance-conditions
?Enabled(verify-compliance-conditions("company-a", "company-b", 1, "building-energy-consumption-prediction", "housing-characteristics-data")).

// Verify compliance-conditions-verified holds for company-c
?Holds(compliance-conditions-verified("company-c", 1, "building-energy-consumption-prediction")).

// Verify compliance-conditions-verified does not hold for company-b
?Holds(compliance-conditions-verified("company-b", 1, "building-energy-consumption-prediction")).

// Step 5 - Authorize training round
// company-c succeeds
authorize-training-round("company-a", "company-c", 1, "building-energy-consumption-prediction").

// company-b fails
?Enabled(authorize-training-round("company-a", "company-b", 1, "building-energy-consumption-prediction")).

// Verify training-round-authorized holds for company-c
?Holds(training-round-authorized("company-c", 1, "building-energy-consumption-prediction")).

// Verify training-round-authorized does not hold for company-b
?Holds(training-round-authorized("company-b", 1, "building-energy-consumption-prediction")).

// Step 6 - Expire training round
// company-c succeeds
expire-training-round("company-a", "company-c", 1, "building-energy-consumption-prediction").

// Verify training-round-authorized is terminated for c
?Holds(training-round-authorized("company-c", 1, "building-energy-consumption-prediction")). // False

// Verify training-round-authorized does not hold for company-b
?Holds(training-round-authorized("company-b", 1, "building-energy-consumption-prediction")). // False
